managed_components/
dependencies.lock

# 发布分发包。由 tools/package_radio_release.sh 生成、CI 上传到 GitHub Releases——
# 仓库里不该再存一份几 MB 的二进制。
dist/

# tools/backup_flash.sh 读出的整片 16MB Flash 镜像
backup/

